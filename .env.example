# ===== Variables de entorno del backend =====
# Renombra este archivo a .env y completa los valores
# NUNCA subas el archivo .env real a GitHub

# Conexión a PostgreSQL (Render entrega esta variable automáticamente al
# vincular la base de datos al servicio web)
DATABASE_URL=postgresql://usuario:password@host:5432/finpredict_db

# Secreto para firmar tokens JWT (genera uno largo y aleatorio)
JWT_SECRET=cambia_este_valor_por_una_cadena_larga_y_aleatoria_de_64_caracteres

# Tiempo de expiración del token JWT
JWT_EXPIRES_IN=24h

# Puerto en el que corre el servidor (Render lo asigna automáticamente)
PORT=3000

# Origen permitido del frontend para CORS (URL pública de Vercel)
FRONTEND_URL=https://tu-app.vercel.app

# Configuración SMTP para envío de reportes por correo
# Gmail: usar contraseña de aplicación, no la real
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicación_de_16_caracteres
SMTP_FROM=FinPredict <tu-correo@gmail.com>
